{
  "name": "@krischoichoi/channel-files",
  "version": "0.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krischoichoi/dsh-channels.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Optional generic file storage and document extraction for dsh-channels",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@krischoichoi/channel-core": "workspace:*",
    "@krischoichoi/channel-harness": "workspace:*",
    "mammoth": "1.12.1",
    "unpdf": "1.8.1",
    "xlsx": "0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "rimraf": "^6.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "license": "MIT"
}
